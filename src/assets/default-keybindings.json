[
  { "key": "mod+s", "command": "file.save" },
  { "key": "mod+shift+s", "command": "file.saveAll" },
  { "key": "mod+o", "command": "file.openFile" },
  { "key": "mod+shift+o", "command": "file.openFolder" },

  { "key": "mod+w", "command": "tab.close" },
  { "key": "mod+tab", "command": "tab.next" },
  { "key": "mod+shift+tab", "command": "tab.previous" },

  { "key": "mod+p", "command": "search.file" },
  { "key": "mod+a", "command": "explorer.selectAll", "when": "explorerFocus && !renaming" },
  { "key": "mod+c", "command": "explorer.copy", "when": "explorerFocus && !renaming" },
  { "key": "mod+x", "command": "explorer.cut", "when": "explorerFocus && !renaming" },
  { "key": "mod+v", "command": "explorer.paste", "when": "explorerFocus && !renaming" },
  { "key": "delete", "command": "explorer.delete", "when": "explorerFocus && !renaming" },
  { "key": "f2", "command": "explorer.rename", "when": "explorerFocus && !renaming" },
  { "key": "mod+shift+b", "command": "git.toggleBlame" }
]
