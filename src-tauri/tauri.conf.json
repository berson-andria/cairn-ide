{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cairn",
  "version": "0.1.0",
  "identifier": "com.cost.cairn",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/cairn/browser"
  },
  "plugins": { "fs": { "requireLiteralLeadingDot": false } },
  "app": {
    "windows": [
      {
        "title": "cairn",
        "maximized": true,
        "decorations": false,
        "dragDropEnabled": false,
        "shadow": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
