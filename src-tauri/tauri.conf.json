{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "praide",
  "version": "0.1.0",
  "identifier": "com.cost.praide",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/praide/browser"
  },
  "plugins": { "fs": { "requireLiteralLeadingDot": false } },
  "app": {
    "windows": [
      {
        "title": "praide",
        "maximized": true,
        "decorations": false,
        "dragDropEnabled": false,
        "shadow": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../sdk/python/praide/*.py": "sdk/python/praide/",
      "../sdk/python/workflows/*.py": "sdk/python/workflows/",
      "../sdk/python/templates/*.py": "sdk/python/templates/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
